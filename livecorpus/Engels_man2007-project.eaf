    <TIER ANNOTATOR="anfimovasd" LINGUISTIC_TYPE_REF="utterance"
        PARTICIPANT="comment" TIER_ID="comment">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418"
                TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>также возможен вариант Part,но предложение оборванно,поэтому я предположила, что это было конкретное место,соответственно "там" относится к "получается" и является наречием</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428"
                TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>тут не очень понятно,какую часть речи ставить,тк это фразеологизированное выражение. Я поставила наречие,но тут также может быть краткое прилагательное, если разбирать по отдельности</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340"
                TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>невозможно определить наверняка из-за отсутствия контекста,но это может быть как местоимением-сущ.,так и местоимением-прил. Как по мне, вероятнее вариант мест-сущ, тк информант собирался сказать "это хорошо"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2447"
                TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>я расслышала,что начало было гуля=, но конец не смогла разобрать (там то ли ква, то ли гва, в общем, не очень хорошо слышно) </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2860"
                TIME_SLOT_REF1="ts432" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>тут не уверена, но как будто слово имеет наречное значение "почему-то", слово не выполняет функций местоимения</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2482"
                TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>скорее всего это "вот"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2494"
                TIME_SLOT_REF1="ts464" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>это союзное слово,однако слово имеет роль и смысл, из-за чего можно сказать, что оно является местоимением</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2495"
                TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>это наречие образа действие,слово не является существительным и не несёт соответствующую смысловую нагрузку</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3011"
                TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts524">
                <ANNOTATION_VALUE>мне кажется, что это частица, слово не несёт в себе наречного значения</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2863"
                TIME_SLOT_REF1="ts573" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>тут не совсем понятно,какая часть речи, так как реплика оборвана, но ни местоименного, ни наречного значения это слово не несёт</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2867"
                TIME_SLOT_REF1="ts854" TIME_SLOT_REF2="ts855">
                <ANNOTATION_VALUE>не имеет ни наречного, ни местоименного значения</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2868"
                TIME_SLOT_REF1="ts859" TIME_SLOT_REF2="ts865">
                <ANNOTATION_VALUE>нет значения окончательного совершения, наступления какого-либо действия, скорее, несет усилительный характер или выделяет член предложения,к которому относится</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2871"
                TIME_SLOT_REF1="ts868" TIME_SLOT_REF2="ts873">
                <ANNOTATION_VALUE>нет значения окончательного совершения, наступления какого-либо действия, скорее, несет усилительный характер или выделяет член предложения,к которому относится</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2714"
                TIME_SLOT_REF1="ts881" TIME_SLOT_REF2="ts886">
                <ANNOTATION_VALUE>значение - постоянно,до сих пор</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2879"
                TIME_SLOT_REF1="ts919" TIME_SLOT_REF2="ts920">
                <ANNOTATION_VALUE>выделяет слово "год"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
