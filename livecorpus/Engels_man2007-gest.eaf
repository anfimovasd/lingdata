        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a563"
                TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts257">
                <ANNOTATION_VALUE>кивок, вероятно, сделан с целью показать, что собеседника слушают, то есть для поддержки коммуникации</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
