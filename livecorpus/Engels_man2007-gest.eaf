    <TIER ANNOTATOR="anfimovasd" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@man2007m" PARTICIPANT="@man2007m" TIER_ID="gestComment@man2007m">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a535"
                TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>тут может быть также адаптор - задумчивость, но мне показалось, что прагматический больше подходит и это не связано с эмоциями</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552"
                TIME_SLOT_REF1="ts290" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>кивком показывается не согласие в чем-либо,а уверенность в сказанном ранее</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556"
                TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>здесь тоже можно в целом сказать,что это адаптор, однако мне все же кажется, что этим жестом интервьюер пытается сформулировать мысли, но это выражается в почесывании затылка</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER ANNOTATOR="anfimovasd" DEFAULT_LOCALE="ru"
