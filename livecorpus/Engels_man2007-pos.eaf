    <TIER ANNOTATOR="anfimovasd" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="utterance" PARTICIPANT="@man2007m" TIER_ID="text@man2007m">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2"
                TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts37">
                <ANNOTATION_VALUE>места ну вот набережная у нас хорошая но не то чтобы там / много каких-то интересных эээ / обустроенных там / ммм вещей</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>но / ээ там / нормально по асфальту / красиво да Волга</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a382"
                TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>ну как Волга там она получается</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts73">
                <ANNOTATION_VALUE>сама Волга в этом месте очень широкая да это Волгоградское водохранилище</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>ээ но как бы / эээ / она островами разделяется на несколько протоков / проток не знаю</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>вот и получается к берегу собственно / не очень широкая / речка касается берега</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a381"
                TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>но / всё равно большая достаточно ну то есть</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>аа да Волга это очень приятная как бы река</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts119">
                <ANNOTATION_VALUE>вот не в каждом городе есть большая река</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a380"
                TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>а вот тут / допустим вот я часто ездил значит из Энгельса в Саратов</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>и ты едешь там нуу несколько километров и там прям красивые виды достойные живописные / там</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>вот так что это / Волга это хорошо нда</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
